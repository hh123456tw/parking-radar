# 必填；未設定時 app 會拒絕啟動。產生方式：python -c "import secrets; print(secrets.token_urlsafe(36))"
FLASK_SECRET_KEY=replace-with-a-long-random-string
# 本機以 http 開發時設為 0，否則瀏覽器不會送回 session cookie。
SESSION_COOKIE_SECURE=1
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=parking_hell
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
NOMINATIM_USER_AGENT=parking-hell-radar-student-project/1.0
OPENROUTESERVICE_API_KEY=
ANALYTICS_ENABLED=1
ANALYTICS_REQUIRE_CONSENT=1
ANALYTICS_HMAC_SECRET=
ANALYTICS_SEGMENT_MIN_DEVICES=5
DEPLOY_VERSION=
SNAPSHOT_ARCHIVE_DIR=/opt/parking-archives
